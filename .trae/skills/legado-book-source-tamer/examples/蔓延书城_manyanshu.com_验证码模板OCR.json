  "ruleToc": {
    "chapterList": "@js:\n(function(){\nvar h=String(result||'');\nvar re=/<a href=\"([^\"]+)\" title=\"([^\"]*)\" rel=\"chapter\"><dd>([\\s\\S]*?)<\\/dd><\\/a>/g;\nfunction clean(s){\n return String(s||'').replace(/<[^>]*>/g,'')\n  .replace(/&#xe8[0-9a-fA-F]{2};?/g,'').replace(/&#x([0-9a-fA-F]+);/g,function(a,b){try{var n=parseInt(b,16);return (n<32||n>126)?'':String.fromCharCode(n)}catch(e){return ''}})\n  .replace(/&#(\\d+);?/g,function(a,b){var n=parseInt(b,10);return (n<32||n>126)?'':String.fromCharCode(n)})\n  .replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/&#39;/g,\"'\").trim();\n}\nvar out=[],seen={},m;\nwhile((m=re.exec(h))!==null){\n var u=m[1],n=clean(m[2])||clean(m[3]);\n if(u.charAt(0)==='/')u='https://www.manyanshu.com'+u;\n if(!n||seen[u])continue;seen[u]=1;\n out.push(JSON.stringify({name:n,url:u}));\n}\nvar list=new Packages.java.util.ArrayList();\nfor(var i=0;i<out.length;i++)list.add(out[i]);\nreturn list;\n})()",
