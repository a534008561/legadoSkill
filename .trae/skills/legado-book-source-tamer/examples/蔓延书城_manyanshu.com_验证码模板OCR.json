  "searchUrl": "@js:\n(function(){\nvar BASE='https://www.manyanshu.com';\nvar CH=\"23456789ABCEFGMNPRSTVYZabcdefghkmnprstuvwxyz\";\nvar TB=\"\";\nvar LAST='ms_search_ts';\n// 搜索节流：两次搜索至少间隔 3 秒，降低触发站点风控的概率（不主动探测频率）\nvar last=0;try{last=Number(String(source.get(LAST)||'0'))||0}catch(e0){}\nvar now=Date.now(),wait=3000-(now-last);\nif(wait>0&&wait<=3000){try{Packages.java.lang.Thread.sleep(wait)}catch(e1){}}\ntry{source.put(LAST,String(Date.now()))}catch(e2){}\n\n// 自己固定 PHPSESSID：保证取验证码与提交搜索在任何版本/任何下载通道下都同会话\ntry{\n var sid='mys'+Date.now()+Math.floor(Math.random()*100000);\n cookie.removeCookie(BASE+'/');\n cookie.setCookie(BASE+'/','PHPSESSID='+sid);\n}catch(eS){}\nfunction ocr(){\n try{\n  // java.ajax 取 PNG 会被当作文本解码而损坏，必须用 downloadFile -> readFile 拿原始字节\n  // 站点偶发首次 TCP 连接超时，最多重试 3 次（只重试取图，不重试搜索提交）\n  var b=null;\n  for(var att=0;att<3;att++){\n   try{\n    var p=String(java.downloadFile(BASE+'/searchcode.php?t='+Date.now()+att));\n    b=java.readFile(p);\n    try{java.deleteFile(p)}catch(e3){}\n    if(b&&b.length>500)break;\n   }catch(e4){b=null;try{Packages.java.lang.Thread.sleep(600)}catch(e5){}}\n  }\n  if(!b)return '';\n  var bmp=Packages.android.graphics.BitmapFactory.decodeByteArray(b,0,b.length);\n  if(!bmp)return '';\n  var w=bmp.getWidth(),h=bmp.getHeight(),pix=[];\n  for(var y=0;y<h;y++){for(var x=0;x<w;x++){\n   var c=bmp.getPixel(x,y);\n   var gray=((c>>16&255)*299+(c>>8&255)*587+(c&255)*114)/1000;\n   pix[y*w+x]=(gray<200)?1:0;\n  }}\n  var tpl=java.base64DecodeToByteArray(TB);\n  if(!tpl||tpl.length%49)return '';\n  var slots=[[0,32],[40,74],[88,124],[136,168]],out='';\n  for(var s=0;s<4;s++){\n   var x0=slots[s][0],x1=slots[s][1],minx=999,maxx=-1,miny=999,maxy=-1;\n   for(var y=3;y<39;y++){for(var x=x0;x<x1;x++){\n    if(pix[y*w+x]){if(x<minx)minx=x;if(x>maxx)maxx=x;if(y<miny)miny=y;if(y>maxy)maxy=y;}\n   }}\n   if(maxx<0){out+='?';continue;}\n   var sw=maxx-minx+1,sh=maxy-miny+1,bm=[];\n   for(var yy=0;yy<24;yy++){\n    var sy=Math.min(sh-1,Math.floor((yy+0.5)*sh/24));\n    for(var xx=0;xx<16;xx++){\n     var sx=Math.min(sw-1,Math.floor((xx+0.5)*sw/16));\n     bm.push(pix[(miny+sy)*w+minx+sx]?1:0);\n    }\n   }\n   var best=-1,bc='?';\n   for(var ti=0;ti<tpl.length/49;ti++){\n    var off=ti*49,score=0;\n    for(var k=0;k<384;k++){\n     var by=(tpl[off+1+(k>>3)]&255),bit=(by>>(7-(k&7)))&1;\n     if(bit===bm[k])score++;\n    }\n    if(score>best){best=score;bc=CH.charAt(tpl[off]&255)}\n   }\n   out+=bc;\n  }\n  return out;\n }catch(e){try{java.log('[蔓延书城] OCR失败 '+e)}catch(e2){};return '';}\n}\nvar code=ocr();\nif(code.length!==4){try{java.toast('蔓延书城：验证码识别失败，请重试')}catch(e){};return '';}\nvar k=(typeof key!=='undefined'&&key)?String(key):'';\nreturn BASE+'/s6.html,'+JSON.stringify({method:'POST',body:'keyword='+encodeURIComponent(k)+'&code='+encodeURIComponent(code)});\n})()",
