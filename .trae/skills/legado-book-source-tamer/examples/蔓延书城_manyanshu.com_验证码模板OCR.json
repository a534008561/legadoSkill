  "ruleContent": {
    "content": "@js:\n(function(){\nvar h=String(result||'');\nvar m=h.match(/<div id=\"chapter\">([\\s\\S]*?)<\\/div>/);\nif(!m)return null;\nvar c=m[1];\nc=c.replace(/<br\\s*\\/?>\\s*<br\\s*\\/?>\\s*&nbsp;&nbsp;&nbsp;&nbsp;(?:网页版章节内容慢|请退出转码页面|笔趣派为你提供)[^<]*/g,'');\nc=c.replace(/(?:网页版章节内容慢|请退出转码页面|笔趣派为你提供)[^<]*/g,'');\n// 广告以「【<a href=...>XX网</a>】」形式插在句子中间，整块删掉（故事里的【滴！…】不含 a 标签，不受影响）\nc=c.replace(/【[^<>]*<a\\s+href=\\\"[^\\\"]*\\\"[^>]*>[\\s\\S]*?<\\/a>[^<>]*】/g,'');\nc=c.replace(/M\\.\\./g,'');\nc=c.replace(/www\\.[A-Za-z0-9.-]+\\.[a-z]{2,8}/g,'');\nreturn c;\n})()",
    "nextContentUrl": "@js:\n(function(){\nvar h=String(result||'');\nvar m=h.match(/<a rel=\"next\" href=\"([^\"]+)\"[^>]*>([^<]*)<\\/a>/);\nif(!m||m[2].indexOf('下一页')<0)return null;\nreturn (m[1].charAt(0)==='/')?'https://www.manyanshu.com'+m[1]:m[1];\n})()"
  },
  "ruleExplore": {
    "bookList": "@js:(function(){\nvar h=String(result||''),out=[],seen={};\nfunction add(u,n,a,l,cv){\n if(!u||!n)return;\n if(u.charAt(0)==='/')u='https://www.manyanshu.com'+u;\n if(seen[u])return;seen[u]=1;\n out.push(JSON.stringify({name:n,url:u,author:a||'',lastChapter:l||'',coverUrl:cv||''}));\n}\nfunction txt(x){return String(x||'').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').trim();}\n// 榜单模板 item: dt a = 书名, 首个 btm 文本 = 作者\nvar parts=h.split(/<div class=\"item\"/);\nfor(var i=1;i<parts.length;i++){\n var p=parts[i],m=p.match(/<dt><a href=\"([^\"]+)\"[^>]*>([\\s\\S]*?)<\\/a>/);\n if(!m)continue;\n var a=p.match(/<div class=\"btm\">(?:\\s*<a[^>]*>([^<]*)<\\/a>|([^<]*))/);\n var cv=p.match(/<div class=\"image\">[\\s\\S]*?<img[^>]*data-original=\"([^\"]+)\"/)||p.match(/<div class=\"image\">[\\s\\S]*?<img[^>]*src=\"([^\"]+)\"/);\n add(m[1],txt(m[2]),a?txt(a[1]||a[2]):'','',cv?cv[1]:'');\n}\n// 分类模板 li: 最新入库 s5=作者 / 最近更新 s4=作者 s3=最新章\nvar lis=h.match(/<li>[\\s\\S]*?<\\/li>/g)||[];\nfor(var j=0;j<lis.length;j++){\n var li=lis[j],m2=li.match(/class=\"s2\"><a href=\"([^\"]+)\"[^>]*>([\\s\\S]*?)<\\/a>/);\n if(!m2)continue;\n var au=li.match(/class=\"s4\">([^<]*)/)||li.match(/class=\"s5\">([^<]*)/);\n var lc=li.match(/class=\"s3\"><a[^>]*>([\\s\\S]*?)<\\/a>/);\n add(m2[1],txt(m2[2]),au?txt(au[1]):'',lc?txt(lc[1]):'');\n}\nvar list=new Packages.java.util.ArrayList();\nfor(var k=0;k<out.length;k++)list.add(out[k]);\nreturn list;\n})()\n",
